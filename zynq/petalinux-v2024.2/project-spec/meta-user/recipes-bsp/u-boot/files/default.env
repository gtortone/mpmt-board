
rauc_env_addr=0x1000000
rauc_env_wraddr=0x1100000
rauc_env_offset=0x1FF0000
rauc_env_size=0x10000

rauc_env_vars=mpmtsn mpmttype BOOT_ORDER BOOT_A_LEFT BOOT_B_LEFT

bootargs=earlyprintk earlycon clk_ignore_unused cpuidle.off=1 uio_pdrv_genirq.of_id=generic-uio net.ifnames=0

rauc_env_load= \
   sf probe && \
   sf read ${rauc_env_addr} ${rauc_env_offset} ${rauc_env_size} && \
   env import -c ${rauc_env_addr} ${rauc_env_size} ${rauc_env_vars}

rauc_env_write= \
   if sf probe && \
      sf erase ${rauc_env_offset} ${rauc_env_size} && \
      sf write ${rauc_env_wraddr} ${rauc_env_offset} ${rauc_env_size}; then \
      echo "QSPI environment saved"; \
   else \
      echo "ERROR: failed to write QSPI environment"; \
   fi

rauc_env_save= \
   if env export -c -s ${rauc_env_size} ${rauc_env_wraddr} ${rauc_env_vars}; then \
      run rauc_env_write; \
   else \
      echo "ERROR: export failed, QSPI left untouched"; \
   fi

rauc_env_save_min= \
   if env export -c -s ${rauc_env_size} ${rauc_env_wraddr} BOOT_ORDER BOOT_A_LEFT BOOT_B_LEFT; then \
      run rauc_env_write; \
   else \
      echo "ERROR: export failed, QSPI left untouched"; \
   fi
 
rauc_select_slot= \
   setenv rauc_slot; \
   setenv rauc_part; \
   for BOOT_SLOT in ${BOOT_ORDER}; do \
      if test "x${rauc_slot}" = "x"; then \
         if test "x${BOOT_SLOT}" = "xA"; then \
            setenv rauc_slot A; setenv rauc_part 1; \
         elif test "x${BOOT_SLOT}" = "xB"; then \
            setenv rauc_slot B; setenv rauc_part 2; \
         fi; \
      fi; \
   done

raucinfo= \
   echo "QSPI offset : ${rauc_env_offset}"; \
   echo "QSPI size   : ${rauc_env_size}"; \
   if run rauc_env_load; then \
      echo "block       : imported"; \
   else \
      echo "block       : UNREADABLE"; \
   fi; \
   echo "BOOT_ORDER  : ${BOOT_ORDER}"; \
   echo "serial      : ${mpmtsn}"; \
   echo "board type  : ${mpmttype}"; \
   run rauc_select_slot; \
   echo "would boot  : slot ${rauc_slot} (mmcblk0p${rauc_part})"

bootrauc= \
   setenv rauc_env_ok; \
   if run rauc_env_load; then \
      setenv rauc_env_ok 1; \
      echo "QSPI environment imported"; \
   else \
      echo "WARNING: QSPI environment unreadable"; \
   fi; \
   if test "x${BOOT_ORDER}" = "x"; then \
      echo "BOOT_ORDER not set, applying default \"A B\""; \
      setenv BOOT_ORDER "A B"; \
      setenv BOOT_A_LEFT "3"; \
      setenv BOOT_B_LEFT "3"; \
      if test "x${rauc_env_ok}" = "x1"; then \
         run rauc_env_save; \
      else \
         echo "block not readable, writing BOOT_ORDER only"; \
         run rauc_env_save_min; \
      fi; \
   fi; \
   run rauc_select_slot; \
   if test "x${rauc_slot}" = "x"; then \
      echo "WARNING: BOOT_ORDER invalid (${BOOT_ORDER}), forcing slot A"; \
      setenv rauc_slot A; \
      setenv rauc_part ${rauc_slot_a_part}; \
   fi; \
   echo "Booting slot ${rauc_slot} from mmcblk0p${rauc_part}"; \
   setenv bootargs ${bootargs} root=/dev/mmcblk0p${rauc_part} rootwait rw cma=320M rauc.slot=${rauc_slot}; \
   load mmc ${rauc_env_dev}:${rauc_part} ${load_address} /boot/image.ub && imxtract ${load_address} kernel-1 ${kernel_load_address} && imxtract ${load_address} fdt-system-top.dtb ${devicetree_load_address} && bootz ${kernel_load_address} - ${devicetree_load_address} 

ethprime=ethernet@e000b000
devicetree_load_address=0x2000000
kernel_load_address=0x2080000
initrd_load_address=0x5000000
load_address=0x09000000
autoload=no
bootdelay=5
tftphome=/mpmt/zynq

bootcmd=run bootrauc

nc=setenv stdout nc;setenv stdin nc
readmac=i2c dev 0; i2c read 50 FA.1 6 0xFFFFFC00
mtdparts=mtdparts=nor0:0x6B0000@0(bootbin),0x1920000@0x6C0000(fitimage),0x10000@0x1FF0000(user)

get_ip= \
   dhcp; \
   while itest $? != 0; do  \
      dhcp;  \
   done;  \
   test -n "$serverip" -a -z "$tftphost" && setenv tftphost "${serverip}"; \
   test -z "$httphost" && setenv "httphost ${tftphost}"

preboot= \
   sf probe 0 0;  \
   run readmac buildmac;  \
   test -z "$ipaddr" && run get_ip ;\
   env import ${load_address}; \
   test -n "$mpmtsn" && setenv bootargs "${bootargs} mpmtsn=${mpmtsn}"; \
   test -n "$mpmttype" && setenv bootargs "${bootargs} mpmttype=${mpmttype}"; \
   test -n "$tftphost" && setenv bootargs "${bootargs} tftphost=${tftphost}"; \
   test -n "$tftphome" && setenv bootargs "${bootargs} tftphome=${tftphome}"; \
   test -n "$httphost" && setenv bootargs "${bootargs} httphost=${httphost}"; \
   test -n "$httphome" && setenv bootargs "${bootargs} httphome=${httphome}"; \
   test -n "$httpport" && setenv bootargs "${bootargs} httpport=${httpport}"; \
   test -n "$tasklist" && setenv bootargs "${bootargs} tasklist=${tasklist}"; \
   run download_uenv && env import ${load_address};  \
   test "$bootmode" = "recovery" && run bootnet; \
   test -n "$autoexec" && run autoexec

buildmac= \
   setenv e "";  \
   setenv sep "";  \
   for i in 0 1 2 3 4 5 ; do  \
      setexpr x 0xFFFFFC00 + $i;  \
      setexpr.b b *$x;  \
      if itest.b ${b} <= 0xF; then  \
         setenv b 0${b};  \
      fi;  \
      setenv e "$e$sep$b"; \
      setenv sep :;  \
   done;  \
   env set ethaddr $e && setexpr ethaddr_str gsub : - ${ethaddr} && echo == MAC address set to $ethaddr from eeprom 

bootqspi=sf probe 0 0 && mtd read fitimage ${load_address} ; bootm ${load_address}

bootnet= \
   test -z "$ipaddr" && run get_ip; \
   run download_fitimage && bootm ${load_address}

download_uenv=tftpboot ${load_address} ${tftphost}:${tftphome}/${ethaddr_str}/uenv.txt || tftpboot ${load_address} ${tftphost}:${tftphome}/default/${mpmttype}/uenv.txt || tftpboot ${load_address} ${tftphost}:${tftphome}/default/uenv.txt
download_bootbin=tftpboot ${load_address} ${tftphost}:${tftphome}/${ethaddr_str}/BOOT.BIN || tftpboot ${load_address} ${tftphost}:${tftphome}/default/${mpmttype}/BOOT.BIN || tftpboot ${load_address} ${tftphost}:${tftphome}/default/BOOT.BIN
download_fitimage=tftpboot ${load_address} ${tftphost}:${tftphome}/${ethaddr_str}/image.ub || tftpboot ${load_address} ${tftphost}:${tftphome}/default/${mpmttype}/image.ub || tftpboot ${load_address} ${tftphost}:${tftphome}/default/image.ub

flash_bootbin= \
   test -z "$ipaddr" && run get_ip; \
   run download_bootbin && mtd erase bootbin && mtd write bootbin ${load_address}

flash_fitimage= \
   test -z "$ipaddr" && run get_ip; \
   run download_fitimage && mtd erase fitimage && mtd write fitimage ${load_address}

verify_bootbin= \
   test -z "$ipaddr" && run get_ip; \
   run download_bootbin && mtd read bootbin 0xA000000 0 ${filesize} && cmp.b ${load_address} 0xA000000 ${filesize}

